{
  "name": "media-tagger",
  "version": "1.0.0",
  "description": "Media file tagger with map view",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.mediatagger.app",
    "productName": "MediaTagger",
    "directories": { "output": "dist" },
    "mac": { "category": "public.app-category.photography", "target": "dmg" },
    "win": { "target": "nsis" }
  }
}
